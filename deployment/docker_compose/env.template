# PIT_KEEP_ALIVE=5m
# CONTINUE_ON_CONNECTOR_FAILURE=
# CONFLUENCE_CONNECTOR_LABELS_TO_SKIP=
# JIRA_CONNECTOR_LABELS_TO_SKIP=
# JIRA_SERVER_API_VERSION=
# JIRA_CLOUD_API_VERSION=
# AIRTABLE_ATTACHMENT_SIZE_THRESHOLD=10485760
# DROPBOX_CONNECTOR_SIZE_THRESHOLD=20971520
# BOX_CONNECTOR_SIZE_THRESHOLD=
# SHAREPOINT_CONNECTOR_SIZE_THRESHOLD=
# OUTLOOK_CONNECTOR_ATTACHMENT_SIZE_THRESHOLD=
# TEAMS_CONNECTOR_ATTACHMENT_SIZE_THRESHOLD=
# GONG_CONNECTOR_START_TIME=
# ZOOM_TRANSCRIPT_LAG_BUFFER_HOURS=
# NOTION_CONNECTOR_DISABLE_RECURSIVE_PAGE_LOOKUP=
# GITHUB_CONNECTOR_BASE_URL=
# MAX_DOCUMENT_CHARS=
# MAX_FILE_SIZE_BYTES=
# Отправлять каждый успешно проиндексированный документ публичного коннектора на
