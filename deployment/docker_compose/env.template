## Адреса сервисов
POSTGRES_HOST=relational_db
REDIS_HOST=cache
# Предельное время ожидания сокета Redis в секундах для клиента приложения (не
# для Celery). Если сервер перестал отвечать, но TCP-сессия не закрыта, через это
# время клиент вернёт ошибку, а не будет держать поток до перезапуска контейнера.
# Увеличьте значения для медленного Redis.
# REDIS_SOCKET_TIMEOUT=30
# REDIS_SOCKET_CONNECT_TIMEOUT=10
MODEL_SERVER_HOST=inference_model_server
INDEXING_MODEL_SERVER_HOST=indexing_model_server
