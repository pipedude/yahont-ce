# Yahont CE: шаблон настроек для Docker Compose.
#
# Скопируйте файл в .env рядом с docker-compose.yml:
#   cp env.template .env
# Раскомментируйте значения, которые хотите изменить. Строки со знаком # в
# начале не действуют. Имена переменных совпадают с Onyx, потому что код
# сервера пока называется Onyx.
#
# ОБЯЗАТЕЛЬНО перед первым запуском:
#   1. Задайте USER_AUTH_SECRET. Пустое значение не запустит сервер:
#        openssl rand -hex 32
#   2. Для рабочей установки смените пароли по умолчанию: POSTGRES_PASSWORD,
#      S3_AWS_SECRET_ACCESS_KEY, OPENSEARCH_ADMIN_PASSWORD.
#
# Запуск: docker compose up -d


################################################################################
## ОСНОВНЫЕ НАСТРОЙКИ
################################################################################
## Тег образов `yahontai/yahont-ce-*`, которые `docker compose up -d` скачивает
## из Docker Hub. latest — последний выпуск. Чтобы закрепить версию, укажите тег
## выпуска вида vX.Y.Z из CHANGELOG.md. Команда `docker compose up -d --build`
## собирает образы из исходного кода и называет их по этому тегу.
IMAGE_TAG=latest

## Версия сервиса выполнения кода (code interpreter). Он выходит отдельно, поэтому
## IMAGE_TAG на него не влияет. В compose указана проверенная версия. Меняйте
## значение, только если нужна другая.
# CODE_INTERPRETER_IMAGE_TAG=

## Реестр, из которого compose берёт образы postgres, redis, nginx, OpenSearch
## и SeaweedFS. По умолчанию docker.io. Укажите зеркало, если Docker Hub
## недоступен.
# BASE_IMAGE_REGISTRY=docker.io

## Порты на хосте. HOST_PORT открывает приложение на localhost:3000,
## HOST_PORT_80 открывает nginx на порту 80.
# HOST_PORT=3000
# HOST_PORT_80=80

## Сервис выполнения кода запускает контейнеры через сокет Docker хоста: сервис
## работает от root и монтирует сокет. Запускайте Yahont только на доверенных
## хостах. Для Docker без root на Linux укажите ${XDG_RUNTIME_DIR}/docker.sock.
# DOCKER_SOCK_PATH=/var/run/docker.sock

## Сборка веб-сервера пропускает проверку типов: каталог тестов не попадает в
## контекст Docker, и проверка падает на импортах тестов. Значение 1 безопасно.
# SKIP_TYPE_CHECK=1

## Настройки входа
# SESSION_EXPIRE_TIME_SECONDS=
### Подписывает cookie сброса пароля, подтверждения почты, состояния OAuth и
### капчи. ОБЯЗАТЕЛЬНО: api_server не запустится с пустым значением.
### Сгенерируйте значение: openssl rand -hex 32
USER_AUTH_SECRET=""
### Токен для эндпоинта /metrics сервера API. Доступ закрыт по умолчанию:
### сборщик метрик должен передавать заголовок `Authorization: Bearer <токен>`.
### Если не задать ни токен, ни DISABLE_METRICS_AUTH, /metrics возвращает 401.
# METRICS_AUTH_TOKEN=
### Значение "true" открывает /metrics БЕЗ аутентификации (явный отказ от защиты).
# DISABLE_METRICS_AUTH=
### Значение "true" открывает всем интерактивную документацию API
### (/openapi.json, /docs, /redoc) БЕЗ аутентификации. По умолчанию выключено:
### маршруты не регистрируются и отвечают 404.
# ENABLE_PUBLIC_DOCS=
### Необязательно
# API_KEY_HASH_ROUNDS=
### Список доменов через запятую, например example.ru, example.com. Регистрироваться
### и входить смогут только пользователи с адресами этих доменов.
# VALID_EMAIL_DOMAINS=
### Значение "true" оставляет список пользователей (GET /users) только
### администраторам. Остальные не смогут перебирать учётные записи и делиться
### агентами с отдельными пользователями.
# USER_DIRECTORY_ADMIN_ONLY=
### Вход через внешних поставщиков (Google, OIDC) настраивается в панели
### администратора, в разделе провайдеров SSO.

## Настройки поиска
## ВРЕМЕННО (только для своего сервера, позже будет удалено): имена наборов
## документов через запятую. Если задано, поиск возвращает результаты только из
## этих наборов (чат не затрагивается). Несуществующее имя ничего не находит и
## пишется в лог. Пусто означает «выключено».
# FORCED_DOCUMENT_SET_NAMES=

## Настройки чата
# HARD_DELETE_CHATS=
# MAX_ALLOWED_UPLOAD_SIZE_MB=250
# Лимит размера загружаемого файла на пользователя (МБ), если администратор не
# задал свой. Ограничивается значением MAX_ALLOWED_UPLOAD_SIZE_MB.
# DEFAULT_USER_FILE_MAX_UPLOAD_SIZE_MB=100

## Лимиты open_url (чтение веб-страниц)
## Предел размера распакованного тела в байтах. Чтение останавливается на
## большем из двух значений.
# OPEN_URL_MAX_HTML_SIZE_BYTES=20971520
# OPEN_URL_MAX_PDF_SIZE_BYTES=52428800
## Предел времени чтения одного ответа в секундах.
# OPEN_URL_BODY_DEADLINE_SECONDS=120
## Предельное число адресов в одном запросе /web-search/open-urls или вызове
## MCP open_urls.
# OPEN_URLS_MAX_URLS_PER_REQUEST=20

## Базовый адрес для перенаправлений. Задайте, если открываете Yahont не через
## localhost, например https://yahont.example.ru
# WEB_DOMAIN=

## Значение false разрешает любому сайту встраивать Yahont в <iframe> и
## отключает защиту от clickjacking. По умолчанию защита включена.
# WEB_FRAME_PROTECTION_ENABLED=false

## Значение true добавляет строгие директивы Content-Security-Policy
## (default-src, script-src, connect-src и другие): они ограничивают, откуда
## грузятся скрипты и куда можно отправлять данные. По умолчанию выключено.
# WEB_STRICT_CSP_ENABLED=true


################################################################################
## НАСТРОЙКИ СЕРВИСОВ
################################################################################
## База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
# POSTGRES_DB=
# POSTGRES_DEFAULT_SCHEMA=
# POSTGRES_USE_NULL_POOL=
# POSTGRES_API_SERVER_POOL_SIZE=
# POSTGRES_API_SERVER_POOL_OVERFLOW
# POSTGRES_POOL_RECYCLE=
# Клиентские TCP keepalive для синхронного движка (отправляются по простаивающим
# соединениям, чтобы PgBouncer или балансировщик не закрывал их молча).
# Включены по умолчанию.
# POSTGRES_TCP_KEEPALIVES=
# POSTGRES_TCP_KEEPALIVES_IDLE=
# POSTGRES_TCP_KEEPALIVES_INTERVAL=
# POSTGRES_TCP_KEEPALIVES_COUNT=
# --- TLS для базы данных (значения sslmode из libpq; не действует при USE_IAM_AUTH=true) ---
# Выберите нужный уровень; каждый следующий включает предыдущий. Без значения
# TLS выключен.
#
#   require       только шифрование: подмену сервера (MITM) НЕ обнаруживает
#   verify-ca     + проверка, что сертификат сервера выдан центром из POSTGRES_SSLROOTCERT
#   verify-full   + проверка имени хоста <- рекомендуем для управляемых баз
#
# verify-ca и verify-full ТРЕБУЮТ POSTGRES_SSLROOTCERT (путь к набору
# корневых сертификатов; для публичных сертификатов подойдёт системный набор).
# POSTGRES_SSLMODE=          # disable | allow | prefer | require | verify-ca | verify-full
# POSTGRES_SSLROOTCERT=      # например /etc/ssl/certs/ca-certificates.crt
#
# Взаимный TLS (необязательно, нужен редко): клиент предъявляет сертификат, и
# сервер проверяет его. Большинству установок это не нужно. Требует
# POSTGRES_SSLMODE со включённым SSL (require, verify-ca или verify-full);
# сертификат и ключ задаются вместе.
# POSTGRES_SSLCERT=          # путь к клиентскому сертификату
# POSTGRES_SSLKEY=           # путь к закрытому ключу клиента
# POSTGRES_SSLKEY_PASSWORD=  # только если файл ключа зашифрован
# DB_READONLY_USER=
# DB_READONLY_PASSWORD=

## Пароль администратора OpenSearch. В compose задан слабый пароль по
## умолчанию (StrongPassword123!): смените его для рабочей установки до
## первого запуска.
# OPENSEARCH_ADMIN_PASSWORD=

## Хранилище файлов: "s3" (по умолчанию, встроенное объектное хранилище) или
## "postgres" (дополнительные сервисы не нужны).
## COMPOSE_PROFILES включает встроенное объектное хранилище SeaweedFS. Чтобы
## хранить файлы в PostgreSQL, уберите s3-filestore из COMPOSE_PROFILES и задайте
## FILE_STORE_BACKEND=postgres.
COMPOSE_PROFILES=s3-filestore
FILE_STORE_BACKEND=s3

## Объектное хранилище (нужно только при FILE_STORE_BACKEND=s3)
## Встроенное хранилище — SeaweedFS. Пара S3_AWS_* служит учётной записью
## администратора.
## БЕЗОПАСНОСТЬ: minioadmin — значение для локальной разработки. Для рабочей
## установки смените оба значения.
S3_ENDPOINT_URL=http://object-store:8333
S3_AWS_ACCESS_KEY_ID=minioadmin
S3_AWS_SECRET_ACCESS_KEY=minioadmin
S3_FILE_STORE_BUCKET_NAME=onyx-file-store-bucket

## Google Cloud Storage (нужно только при FILE_STORE_BACKEND=gcs)
## Дополнительный контейнер не нужен: GCS — управляемый сервис.
## Уберите s3-filestore из COMPOSE_PROFILES, если используете FILE_STORE_BACKEND=gcs.
## По умолчанию используются Application Default Credentials (ADC): они работают
## с GKE Workload Identity, служебной учётной записью Compute Engine и gcloud.
# FILE_STORE_BACKEND=gcs
# GCS_FILE_STORE_BUCKET_NAME=your-gcs-bucket-name
# GCS_FILE_STORE_PREFIX=onyx-files
# GCS_PROJECT_ID=your-gcp-project
# GCS_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json
# GCS_SERVICE_ACCOUNT_KEY_JSON=

## Azure Blob Storage (нужно только при FILE_STORE_BACKEND=azure)
## Дополнительный контейнер не нужен: Azure Blob Storage — управляемый сервис.
## Уберите s3-filestore из COMPOSE_PROFILES, если используете FILE_STORE_BACKEND=azure.
## Порядок проверки учётных данных: строка подключения, затем ключ аккаунта,
## затем DefaultAzureCredential (AKS Workload Identity, управляемое удостоверение
## или az CLI).
# FILE_STORE_BACKEND=azure
# AZURE_FILE_STORE_CONTAINER_NAME=your-container-name
# AZURE_FILE_STORE_PREFIX=onyx-files
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
## Адрес эндпоинта. Если не задан, выводится из имени аккаунта. Задайте явно
## для Azurite или суверенных облаков (например *.blob.core.usgovcloudapi.net).
# AZURE_STORAGE_ACCOUNT_URL=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_KEY=

## Тайм-ауты прокси nginx (в секундах)
## Они задают, сколько nginx ждёт ответа от api_server и web_server. Увеличьте
## значения, если долгие запросы обрываются по тайм-ауту. В compose по умолчанию 600.
# NGINX_PROXY_CONNECT_TIMEOUT=600
# NGINX_PROXY_SEND_TIMEOUT=600
# NGINX_PROXY_READ_TIMEOUT=600

## MCP-сервер
## MCP-сервер даёт внешним MCP-клиентам доступ к поиску по вашим знаниям.
## Чтобы использовать его, раскомментируйте блок mcp_server в docker-compose.yml
## и задайте MCP_SERVER_ENABLED=true. По умолчанию выключен.
# MCP_SERVER_ENABLED=false
## Порт MCP-сервера (по умолчанию 8090)
# MCP_SERVER_PORT=8090
## Источники CORS для MCP-клиентов (список через запятую)
# MCP_SERVER_CORS_ORIGINS=
## Тайм-аут чтения запросов MCP-сервера к серверу API в секундах (по умолчанию 300)
# MCP_SERVER_API_REQUEST_TIMEOUT_SECONDS=300

## Бот Discord
## Бот позволяет общаться с Yahont с серверов Discord.
## Токен бота из Discord Developer Portal (нужен, чтобы включить бота)
# DISCORD_BOT_TOKEN=
## Префикс команд бота (по умолчанию "!")
# DISCORD_BOT_INVOKE_CHAR=!

## Celery
# CELERY_BROKER_POOL_LIMIT=
# CELERY_WORKER_DOCFETCHING_CONCURRENCY=
# CELERY_WORKER_DOCPROCESSING_CONCURRENCY=
# CELERY_WORKER_LIGHT_CONCURRENCY=
# CELERY_WORKER_LIGHT_PREFETCH_MULTIPLIER=
## Время жизни блокировки задачи, которая обновляет документы в индексе, в
## секундах (по умолчанию 120). Увеличьте значение, если проход прерывается с
## ошибкой «no longer owned» или «Lock not owned on completion».
# CELERY_DOCUMENT_SYNC_BEAT_LOCK_TIMEOUT=

## AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=
# Значение true включает IAM-аутентификацию для подключений к Postgres.
USE_IAM_AUTH=false


################################################################################
## РАЗРАБОТКА, ОТЛАДКА И ЛОГИ
################################################################################
## Логи и телеметрия
# LOG_LEVEL задаёт подробность логов во всех процессах Yahont: api_server,
# web_server, серверы моделей, боты и все воркеры Celery. Чтобы задать уровень для
# одного воркера, добавьте `--loglevel=<значение>` в его команду в
# backend/supervisord.conf: явный ключ командной строки сильнее LOG_LEVEL.
LOG_LEVEL=info
LOG_ONYX_MODEL_INTERACTIONS=False
# LOG_ENDPOINT_LATENCY=
# LOG_POSTGRES_LATENCY=
# LOG_POSTGRES_CONN_COUNTS=
# Анонимная телеметрия отправляет сведения об использовании на сервер Yahont
# (telemetry.yahont.ai). В Yahont CE она выключена. Чтобы включить, задайте false.
DISABLE_TELEMETRY=true

## Флаги возможностей
# Показывает в каталоге коннекторов раздел «AI и наблюдаемость» (Braintrust).
# Чтобы скрыть раздел, закомментируйте строку или задайте false.
SHOW_EXTRA_CONNECTORS=true
# DISABLE_MODEL_SERVER=false

## Аналитика
# SENTRY_DSN=


################################################################################
## РАСШИРЕННЫЕ НАСТРОЙКИ
################################################################################
## Бот Slack
# ONYX_BOT_DISABLE_DOCS_ONLY_ANSWER=
# ONYX_BOT_FEEDBACK_VISIBILITY=
# ONYX_BOT_DISPLAY_ERROR_MSGS=
# NOTIFY_SLACKBOT_NO_ANSWER=
# ONYX_BOT_MAX_QPM=
# ONYX_BOT_MAX_WAIT_TIME=

## Расширенные настройки входа и почты
# REQUIRE_EMAIL_VERIFICATION=
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USER=                    # Необязательно: не указывайте для серверов без аутентификации
# SMTP_PASS=                    # Необязательно: не указывайте для серверов без аутентификации
# SMTP_STARTTLS=true            # Значение "false" для серверов без поддержки TLS
# ENABLE_EMAIL_INVITES=
# EMAIL_FROM=                   # Обязательно, если SMTP_USER не задан
# EMAIL_ARCHIVE_BCC_ADDRESSES=  # Необязательно: адреса скрытой копии всех писем (через запятую)
# TRACK_EXTERNAL_IDP_EXPIRY=
# По желанию: при входе через OAuth или OIDC сохранять данные каталога
# поставщика, чтобы дополнять промпты чата и подставлять {{user.<ключ>}} в
# инструкции агентов. Данные каталога уходят в подключённую LLM, поэтому по
# умолчанию выключено.
# IDP_PROFILE_ENRICHMENT_ENABLED=
# Необязательный JSON, который переопределяет псевдонимы полей каталога, например:
# '{"department": ["dept", "division"], "country": ["c"]}'.
# IDP_PROFILE_CLAIM_MAP=
# Источники, которым разрешены кросс-доменные запросы (CORS), через запятую,
# например "https://yahont.example.ru". Если не задано, разрешены все источники,
# но кросс-доменные запросы с cookie запрещены.
# CORS_ALLOWED_ORIGIN=
# JWT_PUBLIC_KEY_URL=
# JWT_EXPECTED_AUDIENCE=
# JWT_EXPECTED_ISSUER=

## Настройки генеративных моделей
# GEN_AI_MAX_TOKENS=
# LLM_SOCKET_READ_TIMEOUT=
# IMAGE_SUMMARIZATION_TIMEOUT=
# CONTEXTUAL_RAG_LLM_TIMEOUT=
# MAX_CHUNKS_FED_TO_CHAT=
# DISABLE_LITELLM_STREAMING=
# LITELLM_EXTRA_HEADERS=
# GEN_AI_API_KEY=
# GENERATIVE_MODEL_ACCESS_CHECK_FREQ=
# LITELLM_CUSTOM_ERROR_MESSAGE_MAPPINGS=
## Учёт использования и стоимости
# Записывает оценённые вызовы генерации в журнал использования пользователя
# (по умолчанию включено). Значение "false" полностью выключает запись.
# USER_USAGE_TRACKING_ENABLED=true
# Фиксированная цена одного изображения в центах, если у litellm нет цены для
# модели изображений (по умолчанию 4).
# DEFAULT_IMAGE_COST_CENTS=4
# Запасная цена в долларах за миллион токенов, если litellm не знает цену модели
# (по умолчанию 0, то есть бесплатно).
# DEFAULT_LLM_INPUT_COST_PER_MTOK=0
# DEFAULT_LLM_OUTPUT_COST_PER_MTOK=0

## Параметры запросов
# DOC_TIME_DECAY=
# HYBRID_ALPHA=
# USE_SEMANTIC_KEYWORD_EXPANSIONS_BASIC_SEARCH=

## Модель эмбеддингов
## Yahont по умолчанию использует мультиязычную модель intfloat/multilingual-e5-small
## (размерность 384, префиксы "query: " и "passage: "). Лучше менять модель
## в панели администратора, в настройках модели эмбеддингов. Смена модели
## требует повторной индексации всех документов. Размерность и префиксы
## должны подходить выбранной модели.
# EMBEDDING_BATCH_SIZE=
# DOCUMENT_ENCODER_MODEL=
# DOC_EMBEDDING_DIM=
# NORMALIZE_EMBEDDINGS=
# ASYM_QUERY_PREFIX=
# ASYM_PASSAGE_PREFIX=
# DISABLE_RERANK_FOR_STREAMING=
# MODEL_SERVER_PORT=
# INDEX_BATCH_SIZE=
# MIN_THREADS_ML_MODELS=

## Индексация
# ENABLED_CONNECTOR_TYPES=
# DISABLE_INDEX_UPDATE_ON_SWAP=
